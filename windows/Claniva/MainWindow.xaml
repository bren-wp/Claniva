<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Claniva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Članarina by BRENDIGO">
  <Grid Background="#F5F7FB">
    <!-- Start with only standard controls: prevent WinUI XAML parse failures caused by
         unsupported Symbol names or identity-dependent ms-appx SVG resources. -->
    <NavigationView x:Name="Navigation"
                    PaneDisplayMode="Auto"
                    CompactModeThresholdWidth="720"
                    ExpandedModeThresholdWidth="1120"
                    OpenPaneLength="238"
                    CompactPaneLength="48"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    SelectionChanged="Navigation_SelectionChanged">
      <NavigationView.PaneHeader>
        <StackPanel Padding="12,16,10,12" Spacing="4">
          <TextBlock Text="Članarina" FontSize="24" FontWeight="Bold"
                     Foreground="#0F1F3A" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="by BRENDIGO" FontSize="12" Foreground="#64748B"/>
        </StackPanel>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Nadzorna ploča" Tag="dashboard"/>
        <NavigationViewItem Content="Članovi" Tag="members"/>
        <NavigationViewItem Content="Članarine" Tag="dues"/>
        <NavigationViewItem Content="Uplate" Tag="payments"/>
        <NavigationViewItem Content="Dugovanja" Tag="debts"/>
        <NavigationViewItem Content="Uplatnice" Tag="slips"/>
        <NavigationViewItem Content="Bankovni izvodi" Tag="bank"/>
        <NavigationViewItem Content="Izvještaji" Tag="reports"/>
        <NavigationViewItem Content="Licenca" Tag="license"/>
        <NavigationViewItem Content="Postavke" Tag="settings"/>
      </NavigationView.MenuItems>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PageContent" Padding="22,16" Spacing="14"
                    HorizontalAlignment="Stretch"/>
      </ScrollViewer>
    </NavigationView>
  </Grid>
</Window>
