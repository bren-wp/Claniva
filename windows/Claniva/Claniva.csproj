<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Keep native WinUI runtime dependencies beside the executable. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Claniva</RootNamespace>
    <AssemblyName Condition="'$(DemoBuild)' != 'true'">Clanarina</AssemblyName>
    <AssemblyName Condition="'$(DemoBuild)' == 'true'">ClanarinaDemo</AssemblyName>
    <DefineConstants Condition="'$(DemoBuild)' == 'true'">$(DefineConstants);DEMO_BUILD</DefineConstants>
    <Version Condition="'$(Version)' == ''">0.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <Content Include="Assets\BrandIcon.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
